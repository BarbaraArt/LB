<Window x:Class="Desktop.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Добавить задачу" Height="450" Width="600" Background="#D3D3D3">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка: Поля ввода -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Название" Margin="0,5"/>
            <TextBox x:Name="TitleBox" Height="40" VerticalContentAlignment="Center" Padding="10" BorderBrush="{x:Null}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Категория" Margin="0,15,0,5"/>
            <TextBox x:Name="CategoryBox" Height="40" VerticalContentAlignment="Center" Padding="10" BorderBrush="{x:Null}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <TextBlock Text="Описание" Margin="0,15,0,5"/>
            <TextBox x:Name="DescBox" Height="84" TextWrapping="Wrap" Padding="10" AcceptsReturn="True" BorderBrush="{x:Null}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Правая колонка: Календарь и время -->
        <StackPanel Grid.Column="1" Margin="10">
            <Calendar x:Name="TaskCalendar" HorizontalAlignment="Center" Height="190" Width="212"/>
            <TextBlock Text="Время" Margin="0,10,0,5"/>
            <TextBox x:Name="TimeBox" Text="12:00" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Создать" Click="Create_Click" Width="250" Height="35" Background="#5CB85C" Foreground="White" Margin="10,0" BorderBrush="{x:Null}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Отмена" Click="Cancel_Click" Width="250" Height="35" Background="#E95432" Foreground="White" Margin="10,0" BorderBrush="{x:Null}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
