<Window x:Class="Desktop.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop"
        Title="Main" Height="489" Width="682">

    <!-- Ссылка на словарь ресурсов (если не подключен в App.xaml) -->
    <Window.Resources>
        
        <ResourceDictionary Source="MainResources.xaml"/>
    </Window.Resources>

    <Grid Margin="0,0,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <StackPanel Grid.Column="0" Background="White">
            <Ellipse Width="60" Height="60" Margin="0,20,0,5" Stroke="Black">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"/>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding UserName}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>

            <Button Content="Задачи" Command="{Binding ShowTasksCommand}" Background="Transparent" BorderBrush="Transparent" Padding="30,10" HorizontalContentAlignment="Left"/>
            <Button Content="История" Command="{Binding ShowHistoryCommand}" Background="Transparent" BorderBrush="Transparent" Padding="30,10" HorizontalContentAlignment="Left"/>

            <Button Content="+" Style="{StaticResource RoundAddButtonStyle}" 
                    Command="{Binding AddTaskCommand}" 
                    Width="54" Height="55" Margin="0,180,0,0"/>
        </StackPanel>

        <!-- Центральная панель -->
        <Grid Grid.Column="1" Margin="20, 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Используем стиль из словаря -->
                        <TextBlock Text="{Binding}" Style="{StaticResource CategoryTextStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTasks}" SelectedItem="{Binding SelectedTask}" 
                     BorderThickness="0" Background="Transparent" Padding="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="4" Margin="10,5" Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel>
                                    <!-- Используем стиль для названия задачи -->
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TaskTitleStyle}"/>
                                    <TextBlock Text="{Binding Time}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Правая панель -->
        <Border Grid.Column="2" Background="White" BorderBrush="#CCCCCC" Margin="10,40,10,40" CornerRadius="5" Padding="15" 
                Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTask.Title}" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding SelectedTask.Time}" Foreground="Gray"/>
                    <TextBlock Text="{Binding SelectedTask.Date}" Foreground="Gray" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding SelectedTask.Description}" TextWrapping="Wrap" Margin="0,10"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <!-- Используем стили кнопок из словаря -->
                    <Button Content="Готово" Command="{Binding CompleteCommand}" Style="{StaticResource TopRoundedButtonStyle}"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource BottomRoundedButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>